generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  description String?
  icon        String?     // lucide icon name
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  subfolders  Subfolder[]
}

model Subfolder {
  id          String     @id @default(cuid())
  name        String
  slug        String
  description String?
  group       String?    // section group label on category page (e.g. "FB Outreach", "Outbound")
  categoryId  String
  order       Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  category    Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  documents   Document[]

  @@unique([categoryId, slug])
  @@index([categoryId])
}

// A Project groups related documents (legacy - kept for compatibility)
model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  platform    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents   Document[]
}

model Document {
  id             String       @id @default(cuid())
  docId          String       @unique
  name           String
  description    String?
  docType        String       @default("SOP")
  funnelStage    String       @default("General")
  owner          String
  department     String?
  channel        String?
  platform       String?
  currentVersion Int          @default(1)
  projectId      String?
  subfolderID    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  project        Project?     @relation(fields: [projectId], references: [id])
  subfolder      Subfolder?   @relation(fields: [subfolderID], references: [id])
  versions       DocVersion[]
  tags           DocTag[]

  @@index([docType])
  @@index([funnelStage])
  @@index([projectId])
  @@index([subfolderID])
  @@index([platform])
}

model DocVersion {
  id          String   @id @default(cuid())
  documentId  String
  version     Int
  versionName String?
  content     String
  contentText String   @default("")
  changeNote  String?
  createdAt   DateTime @default(now())
  createdBy   String   @default("Admin")

  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([documentId])
}

model Tag {
  id   String     @id @default(cuid())
  name String     @unique
  slug String     @unique

  docs DocTag[]
}

model DocTag {
  documentId String
  tagId      String

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([documentId, tagId])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  description String?
  docType     String   @default("SOP")
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Counter {
  id    String @id
  value Int    @default(0)
}
